# Database Configuration (Contoh menggunakan MySQL/PostgreSQL URL format)
DATABASE_URL="mysql://root:password123@localhost:3306/helpdesk_db"

# Authentication
# Gunakan string acak yang panjang untuk JWT Secret di production
JWT_SECRET="your_super_secret_jwt_key_here_min_32_chars"

# Cloudinary Storage (Dapatkan dari dashboard Cloudinary)
CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"

# Google Gemini AI (Dapatkan dari Google AI Studio)
GEMINI_API_KEY="AIzaSy_your_gemini_api_key_here"