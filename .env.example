# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# 1. FOR DOCKER / PRODUCTION (Default)
# Use this configuration if you are running the application via 'docker compose up'
DATABASE_URL="postgresql://root:PostgresPassword123@db:5432/school_tickets?schema=public"

# 2. FOR LOCAL DEVELOPMENT
# Uncomment the line below and comment out option number 1 
# ONLY IF you are running the backend locally using 'bun run dev'
# DATABASE_URL="postgresql://root:PostgresPassword123@127.0.0.1:5433/school_tickets?schema=public"

# ==========================================
# AUTHENTICATION
# ==========================================
# Use any random string for the JWT Secret in your local development environment
JWT_SECRET="your_super_secret_jwt_key_here"

# ==========================================
# THIRD-PARTY SERVICES (Required)
# ==========================================
# Cloudinary Storage (For image/file attachments upload)
CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_api_key_here"
CLOUDINARY_API_SECRET="your_api_secret_here"

# Google Gemini AI (For smart ticket analysis features)
GEMINI_API_KEY="your_gemini_api_key_here"